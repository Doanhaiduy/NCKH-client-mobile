{
    "name": "ntu-student",
    "version": "2.0.7",
    "main": "expo-router/entry",
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        }
    },
    "scripts": {
        "beautiful": "lint-staged",
        "start": "expo start --dev-client",
        "prod": "expo start --no-dev",
        "android": "expo run:android",
        "submit": "eas submit --platform android",
        "build-android": "eas build --platform android --profile production",
        "build-android-dev": "eas build --profile development --platform android",
        "build-ios-dev": "eas build --profile development --platform ios",
        "update": "eas update --branch production",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "prepare": "husky"
    },
    "lint-staged": {
        "src/**/*.{js,ts,jsx,tsx,json,css,scss}": "prettier --single-quote --trailing-comma all --tab-width 4 --print-width 120 --write"
    },
