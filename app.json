{
    "expo": {
        "name": "NTU Student",
        "slug": "ntu_student",
        "scheme": "ntustudent",
        "version": "2.0.0",
        "orientation": "portrait",
        "userInterfaceStyle": "light",
        "icon": "./assets/icon_v2.png",
        "backgroundColor": "#FFFFFF",
        "experiments": {
            "tsconfigPaths": true
        },
        "notification": {
            "icon": "./assets/icon_v2.png"
        },
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/icon_v2.png",
            "backgroundColor": "#030099",
            "resizeMode": "contain"
        },
        "ios": {
            "supportsTablet": true,
            "bundleIdentifier": "com.doanhaiduy.mobile",
            "infoPlist": {
                "NSFaceIDUsageDescription": "Ứng dụng cần sử dụng FaceID để xác thực danh tính của bạn.",
                "NSLocationWhenInUseUsageDescription": "Ứng dụng cần quyền truy cập vị trí để hiển thị bản đồ và vị trí của bạn."
            }
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/icon_v2.png"
            },
            "package": "com.doanhaiduy.mobile",
            "permissions": [
                "android.permission.USE_BIOMETRIC",
                "android.permission.USE_FINGERPRINT",
                "CAMERA",
                "WRITE_EXTERNAL_STORAGE",
                "CAMERA_ROLL",
                "ACCESS_FINE_LOCATION",
                "ACCESS_COARSE_LOCATION"
            ],
            "googleServicesFile": "./google-services.json",
            "useNextNotificationsApi": true,
            "plugins": [
                [
                    "expo-notifications",
                    {
                        "icon": "./assets/icon_v2.png",
                        "color": "#FFFFFF"
                    }
                ]
            ],
            "intentFilters": [
                {
                    "autoVerify": true,
                    "action": "VIEW",
                    "data": {
                        "scheme": "ntustudent",
                        "host": "ntustudent"
                    }
                }
            ]
        },
        "web": {
            "favicon": "./assets/favicon.png",
            "bundler": "metro"
        },
        "plugins": [
            "expo-router",
            "expo-font",
            [
                "expo-local-authentication",
                {
                    "faceIDPermission": "Allow ntuApp to use Face ID.",
                    "faceIDPermissionPrompt": "Allow $(PRODUCT_NAME) to use Face ID"
                }
            ],
            [
                "expo-splash-screen",
                {
                    "image": "./assets/icon_v2.png",
                    "resizeMode": "contain",
                    "backgroundColor": "#030099"
                }
            ],
            [
                "expo-notifications",
                {
                    "icon": "./assets/icon_v2.png",
                    "color": "#FFFFFF"
                }
            ]
        ],
        "extra": {
            "eas": {
                "projectId": "61b61d09-d739-4c06-a399-e6562f8b6fce"
            }
        },
        "runtimeVersion": {
            "policy": "appVersion"
        },
        "updates": {
            "url": "https://u.expo.dev/61b61d09-d739-4c06-a399-e6562f8b6fce"
        }
    }
}
