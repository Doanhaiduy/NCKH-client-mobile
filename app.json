{
  "expo": {
    "name": "NTU Student",
    "slug": "ntu_student",
    "scheme": "ntustudent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "experiments": {
      "tsconfigPaths": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-screen.png",
      "resizeMode": "cover",
      "backgroundImage": "./assets/splash-screen.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.doanhaiduy.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.doanhaiduy.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "61b61d09-d739-4c06-a399-e6562f8b6fce"
      }
    }
  }
}
